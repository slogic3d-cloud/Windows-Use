# ═══════════════════════════════════════════════════════════════
#  ZERO 2.0 — Konfiguration
#  Datei umbenennen in: .env
#  Dann ausfüllen und speichern.
# ═══════════════════════════════════════════════════════════════

# ── PFLICHT: Ohne diese zwei Keys startet ZERO nicht ──────────

# Anthropic API Key → https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs API Key → optional, nur für Premium-Stimme
# Leer lassen = kostenlose Browser-Stimme wird verwendet
ELEVENLABS_API_KEY=


# ── OPTIONAL: Gmail ───────────────────────────────────────────
# Nur nötig wenn du ZERO E-Mails lesen/senden lassen willst.
# Anleitung: https://developers.google.com/gmail/api/quickstart/python
# Nach OAuth2-Einrichtung den Access Token hier eintragen:
GMAIL_ACCESS_TOKEN=


# ── OPTIONAL: Wix S-LOGIC 3D Shop ────────────────────────────
# Nur nötig für Bestellungen/Produkte aus dem Wix-Shop.
# API Key → Wix Developer Center → API Keys
# Account ID + Site ID → Wix Dashboard → URL beim Öffnen deiner Site
WIX_API_KEY=
WIX_ACCOUNT_ID=
WIX_SITE_ID=


# ── OPTIONAL: Obsidian Memory-Vault ──────────────────────────
# Wenn gesetzt, schreibt ZERO jeden Schritt als Markdown-Notiz.
# Beispiel Windows-Pfad:
# OBSIDIAN_VAULT_PATH=C:\Users\Marius\Documents\ObsidianVault
OBSIDIAN_VAULT_PATH=
